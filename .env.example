# =====================================================================
#  PAPO DE BOLA — configuração
#  Copie este arquivo para ".env" e preencha os valores.
# =====================================================================

# ---------------------------------------------------------------------
# 1) LLM (obrigatório) — a IA é chamada por API, não roda no navegador
# ---------------------------------------------------------------------
# Modelo escolhido: Qwen 3.8 27B servido pela Groq.
# O prefixo "groq/" é o que manda o LiteLLM/CrewAI usar a Groq.
LLM_MODEL=groq/qwen/qwen3.8-27b

# Chave da API da Groq: https://console.groq.com/keys
# (também funciona definir GROQ_API_KEY; ou OPENAI_API_KEY para OpenAI etc.)
LLM_API_KEY=

# Opcional: endpoint compatível com OpenAI (DeepSeek, Ollama, vLLM, LM Studio...).
# Exemplos de outros provedores:
#   OpenAI ....... LLM_MODEL=gpt-4o-mini                        + OPENAI_API_KEY
#   OpenRouter ... LLM_MODEL=openrouter/google/gemini-2.5-flash + OPENROUTER_API_KEY
#   DeepSeek ..... LLM_MODEL=deepseek-chat + LLM_BASE_URL=https://api.deepseek.com/v1
#   Ollama ....... LLM_MODEL=ollama/llama3.1 + LLM_BASE_URL=http://localhost:11434
# LLM_BASE_URL=

# Opcional: criatividade das respostas (0 = objetivo, 1 = criativo).
LLM_TEMPERATURE=0.2

# Parâmetros do Qwen 3.8 27B na Groq (os mesmos do exemplo oficial da Groq).
# Opcional: none, minimal, low, medium, high ou xhigh (vazio = padrão do modelo).
LLM_MAX_TOKENS=2048
LLM_TOP_P=0.95
LLM_REASONING_EFFORT=

# ---------------------------------------------------------------------
# 2) Pesquisa na internet dos agentes
# ---------------------------------------------------------------------
# Sem chave, o projeto usa DuckDuckGo (gratuito, mas pode ser limitado).
# Para mais estabilidade, configure UMA das opções abaixo:
#   Tavily  — https://tavily.com        (tem plano gratuito)
#   Serper  — https://serper.dev        (Google Search, plano gratuito)
TAVILY_API_KEY=
SERPER_API_KEY=

# ---------------------------------------------------------------------
# 3) Dados oficiais de futebol (football-data.org)
# ---------------------------------------------------------------------
# Cadastro gratuito em https://www.football-data.org/client/register
# Sem token, tabelas/jogos/artilheiros não são consultados.
FOOTBALL_DATA_TOKEN=

# ---------------------------------------------------------------------
# 4) Ajustes finos (opcional)
# ---------------------------------------------------------------------
# Número máximo de passos do agente pesquisador (4 = econômico para o plano gratuito).
MAX_ITERACOES=4
# Buscas na web por pergunta quando NÃO há dados oficiais (2 = econômico).
# Com dados oficiais do football-data.org, o limite cai para 1 busca — e para
# tabela/jogos/artilharia puros o bot responde direto, sem buscar na web.
MAX_BUSCAS=2
# Número máximo de fontes exibidas na resposta.
MAX_FONTES=8
